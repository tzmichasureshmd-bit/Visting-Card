# ─── Copy this to .env.local on the VPS and fill in real values ───────────────

# Your production domain
NEXT_PUBLIC_APP_URL=https://card.tzmicha.com

# Supabase — get from Supabase dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Optional ──────────────────────────────────────────────────────────────────

# Razorpay (leave blank to disable payments UI)
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# Analytics visitor hash salt (any random string)
# ANALYTICS_SALT=

# Support email shown on legal/contact pages
# NEXT_PUBLIC_SUPPORT_EMAIL=support@tzmicha.com
